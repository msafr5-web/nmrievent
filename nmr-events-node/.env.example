# --- Server ---
NODE_ENV=development
PORT=3000
# Public base URL. It is embedded in every QR code, so it must be the real site URL in production.
BASE_URL=http://localhost:3000
# Number of reverse proxies in front of the app (0 = none). Needed so req.ip is the real client IP.
# Never set this higher than the real number of proxies: X-Forwarded-For is client-controlled.
TRUST_PROXY=0

# --- Database ---
DATABASE_URL="postgresql://nmr:nmr@localhost:5432/nmr_events?schema=public"

# --- Security ---
# Protects the operator endpoints (event projects, crowd staffing, live occupancy).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, those endpoints answer 503.
ADMIN_API_KEY=

# --- OTP (employee registration) ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
# true = the 6-digit code is also returned in the API response (simulation for demos). Never in production.
OTP_DEMO_MODE=true

# --- Optional SMTP. Without it the OTP email is only simulated (printed in the server log). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NMR Events <no-reply@example.com>"

# --- Public badge page: minimal | full ---
# minimal hides date of birth and masks the email (recommended under PDPL).
# full shows the whole verified profile, as in the original brief.
PUBLIC_PROFILE_MODE=minimal
