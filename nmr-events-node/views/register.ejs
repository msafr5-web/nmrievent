<%- include('partials/head', { title: title, path: path }) %>
<section class="container-x max-w-2xl py-10 sm:py-14">
  <h1 class="h-section" data-i18n="r.title">Crew registration</h1>
  <p class="mt-2 text-slate-400" data-i18n="r.sub">Register, confirm your email with a 6-digit code, then receive your QR employee badge.</p>

  <ol class="mt-6 flex gap-2 text-xs" aria-label="Steps">
    <li id="st1" class="tag bg-flame-500/20 text-gold-300" data-i18n="r.step1">1 · Details</li>
    <li id="st2" class="tag bg-white/5 text-slate-400" data-i18n="r.step2">2 · Verify</li>
    <li id="st3" class="tag bg-white/5 text-slate-400" data-i18n="r.step3">3 · Badge</li>
  </ol>

  <form id="reg-form" class="card mt-5 space-y-4" novalidate>
    <div><label class="label" for="fullName" data-i18n="r.name">Full name</label><input id="fullName" name="fullName" class="input" autocomplete="name" maxlength="100" required><p class="err" data-err="fullName"></p></div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class="label" for="dob" data-i18n="r.dob">Date of birth</label><input id="dob" name="dob" type="date" class="input" autocomplete="bday" required><p class="err" data-err="dob"></p></div>
      <div><label class="label" for="email" data-i18n="r.email">Email</label><input id="email" name="email" type="email" class="input" autocomplete="email" maxlength="254" required><p class="err" data-err="email"></p></div>
    </div>
    <div><label class="label" for="bio" data-i18n="r.bio">Short bio</label><textarea id="bio" name="bio" rows="3" maxlength="1000" class="input" required></textarea><p class="err" data-err="bio"></p></div>
    <div><label class="label" for="experience" data-i18n="r.exp">Experience</label><textarea id="experience" name="experience" rows="3" maxlength="1000" class="input" required></textarea><p class="err" data-err="experience"></p></div>
    <p id="reg-err" class="err" role="alert"></p>
    <button class="btn-primary w-full" type="submit" data-i18n="r.submit">Send verification code</button>
  </form>

  <form id="otp-form" class="card mt-5 hidden space-y-4" novalidate>
    <h2 class="text-lg font-bold text-white" data-i18n="r.otp.title">Enter the 6-digit code</h2>
    <p class="text-sm text-slate-400"><span data-i18n="r.otp.sub">We sent a code to</span> <strong id="otp-email" class="text-slate-200"></strong></p>
    <p id="demo-box" class="hidden rounded-xl border border-gold-400/40 bg-gold-400/10 p-3 text-sm text-gold-300"><span data-i18n="r.demo">Demo mode: your code is</span> <strong id="demo-code" class="font-mono text-lg tracking-widest"></strong></p>
    <div><label class="label" for="otp" data-i18n="r.code">Verification code</label><input id="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="\d{6}" class="input text-center font-mono text-2xl tracking-[0.5em]" required></div>
    <p id="otp-err" class="err" role="alert"></p>
    <div class="flex flex-wrap gap-3">
      <button class="btn-primary flex-1" type="submit" data-i18n="r.verify">Verify and get badge</button>
      <button id="resend" class="btn-ghost" type="button" data-i18n="r.resend">Resend code</button>
    </div>
  </form>

  <div id="done" class="card mt-5 hidden text-center" aria-live="polite">
    <p class="tag mx-auto bg-emerald-500/15 text-emerald-300" data-i18n="b.verified">Verified</p>
    <h2 class="mt-3 text-xl font-bold text-white" data-i18n="r.done.title">Registration complete</h2>
    <p class="mt-2 text-sm text-slate-400" data-i18n="r.done.sub">Your tracking ID and QR badge are ready.</p>
    <p class="mt-4 font-mono text-lg tracking-wider text-gold-300" id="done-id"></p>
    <a id="done-link" class="btn-primary mt-5" href="#" data-i18n="r.view">Open my badge</a>
  </div>
</section>
<%- include('partials/foot') %>
<script src="/js/register.js"></script>
</body></html>
