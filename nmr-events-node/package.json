{
  "name": "nmr-events-node",
  "version": "1.0.0",
  "description": "NMR Events platform: Express + Prisma + PostgreSQL + Three.js",
  "private": true,
  "main": "src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i public/css/input.css -o public/css/app.css --minify",
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --test tests/*.test.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "seed": "node prisma/seed.js",
    "dev:css": "tailwindcss -c tailwind.config.js -i public/css/input.css -o public/css/app.css --watch"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "uuid": "^9.0.1",
    "zod": "^4.6.7",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
