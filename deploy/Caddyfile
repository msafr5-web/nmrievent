# SITE_ADDRESS: النطاق الأساسي (مثل nmrevent.com) لتفعيل HTTPS تلقائيًا بشهادة Let's Encrypt،
# أو ":80" للعمل عبر عنوان IP بدون تشفير.
{$SITE_ADDRESS::80} {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format json
	}
}

# www -> النطاق الأساسي (تحويل دائم). بدون نطاق مضبوط يبقى على قيمة لا تطابق أي طلب.
{$WWW_ADDRESS:http://www.invalid} {
	redir https://{$SITE_ADDRESS:localhost}{uri} permanent
}
