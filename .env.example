# رقم واتساب الأعمال بالصيغة الدولية بدون + (مثال: 9665XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=966547047635
# عنوان الموقع لتوليد sitemap و OpenGraph
NEXT_PUBLIC_SITE_URL=https://nmrevent.com
# (اختياري) Webhook لاستقبال طلبات RFQ — مثل NestJS API أو CRM أو n8n
RFQ_WEBHOOK_URL=
# (اختياري، موصى به) سر توقيع HMAC-SHA256 لطلبات الـ Webhook — 16 حرفًا على الأقل
RFQ_WEBHOOK_SECRET=
# مهلة الـ Webhook بالميلي ثانية (افتراضي 5000)
RFQ_WEBHOOK_TIMEOUT_MS=5000
# حد الطلبات لكل عنوان IP ضمن النافذة (افتراضي 5 / 10 دقائق)
RFQ_RATE_LIMIT=5
RFQ_RATE_WINDOW_MS=600000
# مستوى السجلات: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# (اختياري) Upstash Redis لمحدِّد معدل موزّع بين النسخ — يُضبطان معًا
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# PostgreSQL لحفظ الطلبات قبل التسليم (npm run db:migrate لإنشاء الجدول)
DATABASE_URL=
# سر استدعاء /api/rfq/retry من الـ cron كـ Authorization: Bearer (16 حرفًا على الأقل)
CRON_SECRET=
# مدة الاحتفاظ بالطلبات المنتهية بالأيام قبل حذفها تلقائيًا بواسطة مهمة الـ cron (افتراضي 180)
RFQ_RETENTION_DAYS=180
# ----- لوحة التحكم -----
# البريد الوحيد للمدير الأعلى (يمنح الصلاحيات ويدير المستخدمين)
SUPER_ADMIN_EMAIL=msafr.5@gmail.com
# رمز لمرة واحدة لإنشاء حساب المدير الأعلى من /admin/setup (24 حرفًا على الأقل)
ADMIN_BOOTSTRAP_TOKEN=
# مجلد الصور المرفوعة والسير الذاتية (افتراضي ./data)
UPLOAD_DIR=./data
ADMIN_SESSION_HOURS=12
# مدة الاحتفاظ بطلبات التقديم المرفوضة بالأيام (افتراضي 365)
APPLICATION_RETENTION_DAYS=365
