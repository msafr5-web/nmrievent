# ======== الموقع ========
NEXT_PUBLIC_SITE_URL=https://nmrievent.com
# رقم واتساب الأعمال بالصيغة الدولية بدون + (مثال: 9665XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000

# ======== الأمان والمصادقة (إلزامي في الإنتاج) ========
# سلسلة عشوائية طويلة لتوقيع جلسات JWT ورموز QR: openssl rand -base64 48
AUTH_SECRET=
# كلمات مرور بوابتي الإدارة العليا والفرق الميدانية (في التطوير: admin123 / ops123)
ADMIN_PASSWORD=
OPS_PASSWORD=

# ======== التكاملات ========
# Webhook لاستقبال كل طلب RFQ (CRM أو خادم NestJS أو n8n)
RFQ_WEBHOOK_URL=
# Webhook للإشعارات: رمز OTP، إسناد الكوادر، الاعتمادات (يُرسلها مزود البريد / WhatsApp Business API)
NOTIFY_WEBHOOK_URL=
# true = يُعرض رمز OTP على الشاشة وبيانات الدخول التجريبية (للعرض فقط، لا تفعّله في الإنتاج الحقيقي)
OTP_DEMO_MODE=false

# ======== التحليلات (اختياري) ========
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HOTJAR_ID=

# ======== التخزين ========
# مجلد ملف البيانات في النموذج الأولي (يُستبدل بـ PostgreSQL)
DATA_DIR=
